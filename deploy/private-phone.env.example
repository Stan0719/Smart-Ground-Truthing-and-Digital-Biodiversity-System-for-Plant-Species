# After an approved PRIVATE VPN setup, replace the hostname printed by tailscale serve.
# This file is an example; it is not loaded automatically and contains no credentials.
EXPO_PUBLIC_API_ENV=development
EXPO_PUBLIC_PLANT_API_URL_DEVELOPMENT=https://YOUR-NODE.YOUR-TAILNET.ts.net
EXPO_PUBLIC_FACE_API_URL_DEVELOPMENT=https://YOUR-NODE.YOUR-TAILNET.ts.net/face

# Preferred: once approved HTTPS is verified, this single origin overrides legacy
# separate URLs and derives the face prefix /face. Never use the placeholder.
# EXPO_PUBLIC_PRIVATE_GATEWAY_URL=https://YOUR-NODE.YOUR-TAILNET.ts.net
