# Private PostgreSQL connection. Copy to .env and enter your own credentials.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@YOUR_DATABASE_HOST:5432/postgres
# Local settings are used only when DATABASE_URL is absent.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plant_conservation_dev
DB_USER=plant_app
DB_PASSWORD=
PORT=3000
HOST=127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For a private certificate authority: PGSSLROOTCERT=C:/private/root.crt
# Runtime storage is PostgreSQL; PLANT_DB/AUTH_DB SQLite paths are retired.
