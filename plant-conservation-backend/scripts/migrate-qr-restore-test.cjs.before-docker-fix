"use strict";

const { createHash } = require("node:crypto");
const fs = require("node:fs");
const { spawnSync } = require("node:child_process");
const { resolve } = require("node:path");
const { Pool } = require("pg");
const { backupPostgres } = require("./postgres-backup.cjs");

const TARGET = Object.freeze({
  clientHost: "127.0.0.1",
  clientPort: 55434,
  database: "backup_restore_test_20261114",
  user: "postgres",
  serverAddress: "172.17.0.4",
  serverPort: 5432,
});
const MIGRATION_PATH = resolve(
  __dirname,
  "../migrations/015-local-qr-only-move.sql",
);
const PERMISSION_PREFLIGHT = `
  SELECT
    to_regclass('public.qr_code') IS NOT NULL AS source_exists,
    to_regnamespace('plant_app') IS NOT NULL AS schema_exists,
    COALESCE((
      SELECT migration_role.rolsuper
        OR source.relowner = migration_role.oid
        OR pg_has_role(current_user, source.relowner, 'USAGE')
      FROM pg_class source
      JOIN pg_roles migration_role ON migration_role.rolname = current_user
      WHERE source.oid = to_regclass('public.qr_code')
    ), false) AS can_move,
    CASE
      WHEN to_regnamespace('plant_app') IS NULL THEN false
      ELSE has_schema_privilege(current_user, to_regnamespace('plant_app'), 'CREATE')
    END AS can_create
`;

const ROUTING_OVERRIDES = Object.freeze({
  PGHOST: TARGET.clientHost,
  PGPORT: String(TARGET.clientPort),
  PGDATABASE: TARGET.database,
  PGUSER: TARGET.user,
});

function assertTargetEnvironment(env) {
  if (Object.keys(env).some((name) => name.toUpperCase() === "DATABASE_URL"))
    throw Error("DATABASE_URL is forbidden for the local QR restore runner.");
  for (const [providedName, value] of Object.entries(env)) {
    const name = providedName.toUpperCase();
    if (!/^PG[A-Z0-9_]*$/.test(name)) continue;
    if (Object.hasOwn(ROUTING_OVERRIDES, name)) {
      if (value !== ROUTING_OVERRIDES[name])
        throw Error(`${name} override does not match the fixed local target.`);
      continue;
    }
    throw Error(`${name} environment override is forbidden for the local QR restore runner.`);
  }
  return { ...TARGET };
}

function skipSqlTrivia(sql, offset) {
  let index = offset;
  while (index < sql.length) {
    if (/\s/.test(sql[index])) {
      index++;
      continue;
    }
    if (sql.startsWith("--", index)) {
      const newline = sql.indexOf("\n", index + 2);
      index = newline < 0 ? sql.length : newline + 1;
      continue;
    }
    if (sql.startsWith("/*", index)) {
      let depth = 1;
      index += 2;
      while (index < sql.length && depth > 0) {
        if (sql.startsWith("/*", index)) {
          depth++;
          index += 2;
        } else if (sql.startsWith("*/", index)) {
          depth--;
          index += 2;
        } else index++;
      }
      if (depth !== 0) throw Error("Unterminated SQL comment in migration.");
      continue;
    }
    break;
  }
  return index;
}

function scanTopLevelStatements(sql) {
  const statements = [];
  let index = 0;
  let tokens = [];
  let start = null;

  while (index < sql.length) {
    index = skipSqlTrivia(sql, index);
    if (index >= sql.length) break;
    if (start === null) start = index;

    const char = sql[index];
    if (char === "'") {
      index++;
      let closed = false;
      while (index < sql.length) {
        if (sql[index] === "'") {
          if (sql[index + 1] === "'") index += 2;
          else {
            index++;
            closed = true;
            break;
          }
        } else if (sql[index] === "\\" && index + 1 < sql.length) index += 2;
        else index++;
      }
      if (!closed) throw Error("Unterminated SQL string in migration.");
      tokens.push("STRING");
      continue;
    }
    if (char === '"') {
      index++;
      let closed = false;
      while (index < sql.length) {
        if (sql[index] === '"') {
          if (sql[index + 1] === '"') index += 2;
          else {
            index++;
            closed = true;
            break;
          }
        } else index++;
      }
      if (!closed) throw Error("Unterminated quoted identifier in migration.");
      tokens.push("IDENTIFIER");
      continue;
    }
    if (char === "$") {
      const delimiter = sql.slice(index).match(/^\$(?:[A-Za-z_][A-Za-z_0-9]*)?\$/)?.[0];
      if (delimiter) {
        const close = sql.indexOf(delimiter, index + delimiter.length);
        if (close < 0) throw Error("Unterminated dollar-quoted SQL in migration.");
        index = close + delimiter.length;
        tokens.push("DOLLAR_STRING");
        continue;
      }
    }
    if (/[A-Za-z_]/.test(char)) {
      const word = sql.slice(index).match(/^[A-Za-z_][A-Za-z_0-9$]*/)[0];
      tokens.push(word.toUpperCase());
      index += word.length;
      continue;
    }
    if (char === ";") {
      statements.push({ tokens, start, end: index + 1 });
      tokens = [];
      start = null;
      index++;
      continue;
    }
    tokens.push(char);
    index++;
  }

  if (tokens.length) throw Error("Migration has an unterminated top-level statement.");
  return statements;
}

function splitTransactionWrappedMigration(sql) {
  const statements = scanTopLevelStatements(sql);
  const begin = statements.filter(
    (statement) => statement.tokens.length === 1 && statement.tokens[0] === "BEGIN",
  );
  const commit = statements.filter(
    (statement) => statement.tokens.length === 1 && statement.tokens[0] === "COMMIT",
  );
  if (
    begin.length !== 1 ||
    commit.length !== 1 ||
    statements.length !== 3 ||
    statements[0] !== begin[0] ||
    statements[2] !== commit[0] ||
    statements[1].tokens[0] !== "DO" ||
    begin[0].end > statements[1].start ||
    statements[1].end > commit[0].start
  )
    throw Error("Migration must contain one BEGIN, one DO block, and one COMMIT.");

  const body = sql.slice(begin[0].end, commit[0].start);
  if (!body.includes("DO")) throw Error("Migration body is missing its DO block.");
  return { body, begin, commit };
}

function extractPreflightOnlySql(body) {
  const marker = /^\s{4}ALTER TABLE public\.qr_code SET SCHEMA plant_app;\s*$/gm;
  const matches = [...body.matchAll(marker)];
  if (matches.length !== 1)
    throw Error("Expected exactly one QR schema-move statement in migration 015.");
  const markerStart = matches[0].index;
  const preflightPrefix = body.slice(0, markerStart);
  if (!/^\s*DO\s+\$\$/.test(preflightPrefix))
    throw Error("Migration preflight is not the expected DO block.");
  if (/^\s*(?:ALTER|CREATE|DROP|TRUNCATE|INSERT|UPDATE|DELETE)\b/im.test(preflightPrefix))
    throw Error("Preflight section contains an unexpected persistent SQL statement.");
  return `${preflightPrefix}\n  END;\n  $$;`;
}

function assertServerIdentity(row) {
  if (!row || row.current_database !== TARGET.database)
    throw Error("Connected database does not match the fixed local restore target.");
  if (row.server_address !== TARGET.serverAddress)
    throw Error("PostgreSQL server address does not match the reviewed local Docker container.");
  if (Number(row.server_port) !== TARGET.serverPort)
    throw Error("PostgreSQL server port does not match the reviewed local container port.");
}

function assertMovePermissions(row) {
  if (!row?.source_exists)
    throw Error("public.qr_code is missing from the local restore database.");
  if (!row.schema_exists)
    throw Error("plant_app schema is missing from the local restore database.");
  if (!row.can_move)
    throw Error("Migration role lacks effective ownership rights on public.qr_code.");
  if (!row.can_create)
    throw Error("Migration role lacks CREATE on plant_app.");
}

async function promptForLocalPassword({ input = process.stdin, output = process.stderr } = {}) {
  if (!input.isTTY || typeof input.setRawMode !== "function")
    throw Error("An interactive terminal is required for the local PostgreSQL password.");
  output.write("Local PostgreSQL password (input hidden): ");
  input.setRawMode(true);
  input.resume();
  return new Promise((resolvePassword, rejectPassword) => {
    let password = "";
    const finish = (error) => {
      input.removeListener("data", onData);
      input.setRawMode(false);
      input.pause();
      output.write("\n");
      if (error) rejectPassword(error);
      else resolvePassword(password);
    };
    const onData = (chunk) => {
      for (const char of chunk.toString("utf8")) {
        if (char === "\u0003") return finish(Error("Password entry cancelled."));
        if (char === "\r" || char === "\n") return finish();
        if (char === "\u007f" || char === "\b") password = password.slice(0, -1);
        else password += char;
      }
    };
    input.on("data", onData);
  });
}

function defaultBackupPath() {
  const timestamp = new Date().toISOString().replace(/[:.]/g, "-");
  return resolve(__dirname, "../backups", `before-qr-restore-test-${timestamp}.dump`);
}

async function sha256File(path) {
  const hash = createHash("sha256");
  await new Promise((resolveHash, rejectHash) => {
    const stream = fs.createReadStream(path);
    stream.on("data", (chunk) => hash.update(chunk));
    stream.on("error", rejectHash);
    stream.on("end", resolveHash);
  });
  return hash.digest("hex");
}

async function createAndVerifyBackup({
  backupFile,
  password,
  createBackup = backupPostgres,
  statFile = fs.statSync,
  runProcess = spawnSync,
  hashFile = sha256File,
}) {
  const settings = {
    DB_HOST: TARGET.clientHost,
    DB_PORT: String(TARGET.clientPort),
    DB_NAME: TARGET.database,
    DB_USER: TARGET.user,
    DB_PASSWORD: password,
  };
  const backupResult = await createBackup(backupFile, {
    settings,
    connection: null,
    scope: "database",
  });
  if (
    !backupResult?.archiveValidated ||
    backupResult.scope !== "database" ||
    backupResult.database !== TARGET.database
  ) throw Error("Backup helper did not confirm a complete backup of the fixed local database.");
  const stat = statFile(backupFile);
  if (!stat.isFile() || stat.size <= 0)
    throw Error("Local database backup is missing or empty.");
  const listing = runProcess("pg_restore", ["--list", backupFile], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    windowsHide: true,
  });
  if (listing.error || listing.status !== 0 || !listing.stdout?.trim())
    throw Error("Local database backup listing/integrity check failed.");
  assertBackupListing(listing.stdout);
  return {
    path: resolve(backupFile),
    sha256: await hashFile(backupFile),
    size: stat.size,
  };
}

function assertBackupListing(listing) {
  const requiredSchemas = ["public", "plant_app", "plant_auth", "plant_face"];
  for (const schema of requiredSchemas) {
    const schemaEntry = new RegExp(
      `^\\s*\\d+;\\s+\\d+\\s+\\d+\\s+SCHEMA\\s+-\\s+${schema}(?:\\s|$)`,
      "m",
    );
    if (!schemaEntry.test(listing))
      throw Error(`Local database backup is missing expected schema ${schema}.`);
  }
  const requiredEntries = [
    [/^\s*\d+;\s+\d+\s+\d+\s+TABLE\s+public\s+qr_code(?:\s|$)/m, "public.qr_code"],
    [/^\s*\d+;\s+\d+\s+\d+\s+SEQUENCE\s+public\s+qr_code_qr_id_seq(?:\s|$)/m, "public.qr_code_qr_id_seq"],
  ];
  for (const [pattern, name] of requiredEntries) {
    if (!pattern.test(listing))
      throw Error(`Local database backup is missing expected object ${name}.`);
  }
}

async function runLocalQrRestoreTest({
  mode = "validate",
  env = process.env,
  createPool = (config) => new Pool(config),
  createBackup = backupPostgres,
  readFile = fs.readFileSync,
  statFile = fs.statSync,
  runProcess = spawnSync,
  hashFile = sha256File,
  getPassword = promptForLocalPassword,
  backupFile = defaultBackupPath(),
} = {}) {
  if (mode !== "validate" && mode !== "apply")
    throw Error("Mode must be validate or apply.");
  assertTargetEnvironment(env);

  const migrationSql = readFile(MIGRATION_PATH, "utf8");
  const wrapped = splitTransactionWrappedMigration(migrationSql);
  const preflightSql = extractPreflightOnlySql(wrapped.body);
  const password = await getPassword();
  const pool = createPool({
    host: TARGET.clientHost,
    port: TARGET.clientPort,
    database: TARGET.database,
    user: TARGET.user,
    password,
    ssl: false,
    connectionTimeoutMillis: 10000,
  });

  let client;
  let transactionStarted = false;
  try {
    client = await pool.connect();
    const identity = (await client.query(
      "SELECT current_database() AS current_database, inet_server_addr()::text AS server_address, inet_server_port() AS server_port",
    )).rows[0];
    assertServerIdentity(identity);
    assertMovePermissions((await client.query(PERMISSION_PREFLIGHT)).rows[0]);

    await client.query("BEGIN");
    transactionStarted = true;
    await client.query("SELECT pg_advisory_xact_lock(87423902)");
    await client.query(preflightSql);
    await client.query("ROLLBACK");
    transactionStarted = false;

    if (mode === "validate")
      return { mode, target: { ...TARGET }, migration: "015-local-qr-only-move.sql" };

    const backup = await createAndVerifyBackup({
      backupFile,
      password,
      createBackup,
      statFile,
      runProcess,
      hashFile,
    });
    console.log(
      `Verified complete local database backup: ${backup.path}\nSize: ${backup.size} bytes\nSHA256: ${backup.sha256}`,
    );

    await client.query("BEGIN");
    transactionStarted = true;
    await client.query("SELECT pg_advisory_xact_lock(87423902)");
    assertMovePermissions((await client.query(PERMISSION_PREFLIGHT)).rows[0]);
    await client.query(wrapped.body);
    await client.query("COMMIT");
    transactionStarted = false;
    return {
      mode,
      target: { ...TARGET },
      migration: "015-local-qr-only-move.sql",
      backup,
    };
  } catch (error) {
    if (transactionStarted && client)
      await client.query("ROLLBACK").catch(() => {});
    throw error;
  } finally {
    client?.release();
    await pool.end();
  }
}

function parseMode(argv) {
  if (argv.length === 0 || (argv.length === 1 && argv[0] === "--validate"))
    return "validate";
  if (argv.length === 1 && argv[0] === "--apply") return "apply";
  throw Error("Use no arguments or --validate for checks; --apply is the separate apply mode.");
}

async function main(argv = process.argv.slice(2)) {
  const mode = parseMode(argv);
  try {
    const result = await runLocalQrRestoreTest({ mode });
    console.log(mode === "validate"
      ? "Local target and migration preflight validated; no migration was applied."
      : "Local QR migration completed.");
  } catch (error) {
    console.error(error.code ? `Local QR restore runner failed: ${error.code}` : error.message);
    process.exitCode = 1;
  }
}

if (require.main === module) main();

module.exports = {
  TARGET,
  assertMovePermissions,
  assertServerIdentity,
  assertTargetEnvironment,
  assertBackupListing,
  createAndVerifyBackup,
  extractPreflightOnlySql,
  parseMode,
  runLocalQrRestoreTest,
  splitTransactionWrappedMigration,
};
