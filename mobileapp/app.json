{
  "expo": {
    "name": "mobileapp",
    "slug": "mobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Niah Biodiversity to use the camera for optional face registration and recognition."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Niah Biodiversity to use Face ID to unlock your saved login."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Niah Biodiversity to capture a photo for optional face login.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "scheme": "niahbiodiversity"
  }
}
