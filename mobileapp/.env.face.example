# Public configuration, not a password or API key. Use a reachable HTTPS base URL.
# Preserve existing settings when adding to mobileapp/.env.local.
EXPO_PUBLIC_FACE_API_URL=https://your-backend-host

# Python face storage reads this server-only configuration from .env.face.
# DATABASE_URL falls back to plant-conservation-backend/.env; never use EXPO_PUBLIC_ for it.
# FACE_DATABASE_URL=postgresql://app:ENCODED_PASSWORD@HOST:5432/DATABASE
FACE_PG_SCHEMA=plant_face
