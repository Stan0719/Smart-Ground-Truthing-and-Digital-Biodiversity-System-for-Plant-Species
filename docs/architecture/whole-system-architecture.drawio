  <diagram id="whole-system-architecture" name="Whole System Architecture">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Whole System Architecture&#xa;Smart Ground-Truthing and Digital Biodiversity System for Plant Species" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#173C31;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="1750" height="72" as="geometry"/></mxCell>
        <mxCell id="actors" value="&lt;b&gt;USER ROLES&lt;/b&gt;   Website: public visitors, Administrator, Conservation Officer, Botanist     •     Mobile: Visitor, Conservation Officer, Botanist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F7F2;strokeColor=#B8CFC2;fontColor=#244B3C;fontSize=15;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="1785" height="58" as="geometry"/></mxCell>

        <mxCell id="clients-bg" value="01  CLIENT APPLICATIONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F0FA;strokeColor=#C5D5E5;fontColor=#173C31;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="25" y="185" width="445" height="450" as="geometry"/></mxCell>
