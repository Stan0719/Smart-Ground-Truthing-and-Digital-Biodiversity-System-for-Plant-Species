        <mxCell id="card-0-0" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.2;margin-bottom:9px&quot;&gt;Vue website&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Public catalogue, plant and species details, and staff dashboards&lt;br&gt;Vue I18n interface strings&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8eacd1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=14;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
