        </mxCell>
        <mxCell id="card-1-1" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.2;margin-bottom:9px&quot;&gt;Plant API · Node.js / Express&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Records, approval workflows, maps, QR, reports and translation&lt;br&gt;Applies authorization and record visibility&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8cbba6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=14;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
