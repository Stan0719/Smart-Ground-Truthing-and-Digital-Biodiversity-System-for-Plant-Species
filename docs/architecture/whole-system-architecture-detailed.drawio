        <mxCell id="card-2-0" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:1.2;margin-bottom:9px&quot;&gt;Supabase PostgreSQL&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;plant_auth · accounts and sessions&lt;br&gt;plant_app · records and translation cache&lt;br&gt;Face service uses configurable PostgreSQL storage, default schema plant_face&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#c9ac71;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=14;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
