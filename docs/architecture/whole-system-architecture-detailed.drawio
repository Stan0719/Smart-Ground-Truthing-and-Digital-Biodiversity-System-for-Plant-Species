  <diagram id="architecture-4" name="Translation">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="910" connect="1" arrows="1" guides="1" tooltips="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Automatic Database Translation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#14352c;fontFamily=Helvetica;fontSize=36;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1415" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Website and mobile language selection · Node.js Plant API · PostgreSQL cache" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#14352c;fontFamily=Helvetica;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="45" y="80" width="1415" height="32" as="geometry" />
        </mxCell>
        <mxCell id="website" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;Vue website&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;POST /api/website/translations&lt;br&gt;Vite development path: /api/data/website/translations&lt;br&gt;Allowed website origin and applicable cookie session&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8eacd1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="62" y="155" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="mobile" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;Expo mobile app&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;POST /api/mobile/translations&lt;br&gt;Guest access or eligible Botanist / Visitor bearer session&lt;br&gt;Mobile zh is normalized to zh-CN&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8eacd1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="545" y="155" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="english" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;English selection&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Displays the stored source text. Automatic generation translates eligible English prose into Malay or Simplified Chinese.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8eacd1;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="1028" y="155" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;Original source text&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Keep the existing prose if access, language metadata, generation or validation leaves a field without an eligible translation.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9ac71;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="62" y="347" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="eligibility" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;Plant API eligibility&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Apply access and field allowlist. Resolve current source text. Require English metadata for its SHA-256 hash, using conservative detection when eligible.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8cbba6;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="545" y="347" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;PostgreSQL cache lookup&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Look up the matching source hash and target locale in plant_app.plant_translation_cache and validate the cached result.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8cbba6;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="1028" y="347" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="model" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;Ollama · TranslateGemma 4B&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;On a cache miss, eligible prose with sufficient context goes to the private model service. Protect scientific names and technical values.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9ac71;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="62" y="610" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="validation" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;Validate and cache&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Save valid results to the translation cache. Failed generation or validation leaves the original displayed text.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9ac71;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="545" y="610" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="display" value="&lt;div style=&quot;font-size:20px;font-weight:bold;margin-bottom:8px&quot;&gt;Display translated prose&lt;/div&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;Return a validated cached translation or a newly saved result. The current view updates through its existing language selector.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8cbba6;strokeWidth=2;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=12;fontFamily=Helvetica;fontSize=16;fontColor=#14352c;" vertex="1" parent="1">
          <mxGeometry x="1028" y="610" width="410" height="126" as="geometry" />
        </mxCell>
        <mxCell id="web-request" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=0.5;exitY=1;entryX=0.22;entryY=0;" edge="1" parent="1" source="website" target="eligibility">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="267" y="305" />
              <mxPoint x="635" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="mobile-request" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=0.65;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="mobile" target="eligibility">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ineligible" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=0;exitY=0.54;entryX=1;entryY=0.54;" edge="1" parent="1" source="eligibility" target="fallback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eligible" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=1;exitY=0.54;entryX=0;entryY=0.54;" edge="1" parent="1" source="eligibility" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=0.72;exitY=1;entryX=0.72;entryY=0;" edge="1" parent="1" source="cache" target="display">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="miss" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=0.35;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cache" target="model">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1172" y="541" />
              <mxPoint x="267" y="541" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="generated" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=1;exitY=0.52;entryX=0;entryY=0.52;" edge="1" parent="1" source="model" target="validation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saved" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52766b;exitX=1;exitY=0.52;entryX=0;entryY=0.52;" edge="1" parent="1" source="validation" target="display">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="skip-label" value="Ineligible" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#14352c;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
