        <mxCell id="heading-2" value="03  Storage and integrations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#14352c;fontSize=20;fontStyle=1;" vertex="1" parent="1">
