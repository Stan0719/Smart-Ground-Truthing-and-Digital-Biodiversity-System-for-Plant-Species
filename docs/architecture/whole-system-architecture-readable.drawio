        <mxCell id="connection-02" value="&lt;b&gt;02&amp;nbsp;&amp;nbsp; User roles → Expo app&lt;/b&gt;&lt;br&gt;mobile users" style="html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#173C31;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C5D5E5;spacingLeft=12;spacingRight=10;fontSize=15;" vertex="1" parent="1">
