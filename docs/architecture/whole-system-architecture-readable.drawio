        <mxCell id="web" value="&lt;b&gt;Vue website&lt;/b&gt;&lt;br&gt;App.vue + routed public and staff pages&lt;br&gt;Vue I18n interface strings&lt;br&gt;Cookie-based web session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A79C5;fontColor=#163B31;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="275" width="395" height="145" as="geometry" />
        </mxCell>
        <mxCell id="mobile" value="&lt;b&gt;React Native / Expo mobile app&lt;/b&gt;&lt;br&gt;App.js navigation and mobile screens&lt;br&gt;React i18next interface strings&lt;br&gt;Bearer-token plant API client and face client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A79C5;fontColor=#163B31;fontSize=15;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="455" width="395" height="155" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Authentication API • Node.js&lt;/b&gt;&lt;br&gt;web/server/index.mjs • web :3001&lt;br&gt;Web cookie sessions; mobile /api/mobile bearer sessions&lt;br&gt;Account recovery and identity&lt;br&gt;Optional private face-account adapter instance :3002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B64E70;fontColor=#5A2440;fontSize=14;align=left;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="515" y="265" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Mobile HTTPS gateway&lt;/b&gt;&lt;br&gt;Optional unified development route&lt;br&gt;/api/mobile → account API&lt;br&gt;/api → Plant API&lt;br&gt;/face → Python face service&lt;br&gt;Not required when clients use separate configured service URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F3FC;strokeColor=#9870B6;fontColor=#432E59;fontSize=13;align=left;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="515" y="475" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="plant-api" value="&lt;b&gt;Plant API • Node.js / Express :3000&lt;/b&gt;&lt;br&gt;Authentication/session validation and route-level RBAC&lt;br&gt;Plant, species, observations, submissions and reviews&lt;br&gt;Maps, QR, reports, notifications, IoT and camera events&lt;br&gt;Website + mobile translation endpoints&lt;br&gt;Botanist dictionary proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E9F68;fontColor=#174532;fontSize=14;align=left;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="810" y="265" width="305" height="230" as="geometry" />
        </mxCell>
        <mxCell id="face" value="&lt;b&gt;Face service • Python :8000&lt;/b&gt;&lt;br&gt;Face matching and image processing&lt;br&gt;Mobile Face API client; private signed account bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B64E70;fontColor=#5A2440;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="530" width="305" height="85" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="&lt;b&gt;Supabase PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;plant_auth&lt;/b&gt; — accounts and sessions&lt;br&gt;&lt;b&gt;plant_app&lt;/b&gt; — plant/species/observation, IoT, alerts, review and translation tables&lt;br&gt;&lt;b&gt;plant_face&lt;/b&gt; — face-service records (when configured)&lt;br&gt;&lt;br&gt;Clients do not connect directly to PostgreSQL." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#FFFFFF;strokeColor=#4A79C5;fontColor=#163B31;fontSize=15;align=left;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1190" y="265" width="585" height="245" as="geometry" />
        </mxCell>
        <mxCell id="ollama" value="&lt;b&gt;Ollama • local/private&lt;/b&gt;&lt;br&gt;TranslateGemma 4B&lt;br&gt;Called by Plant API for eligible text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#557E69;fontColor=#163B31;fontSize=14;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="535" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="inat" value="&lt;b&gt;iNaturalist API&lt;/b&gt;&lt;br&gt;Online taxon suggestions for the Botanist dictionary&lt;br&gt;Accessed through the Plant API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#557E69;fontColor=#163B31;fontSize=14;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1485" y="535" width="290" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sensors" value="&lt;b&gt;ESP32 + field sensors&lt;/b&gt;&lt;br&gt;DHT11 • soil • rain • MPU6050&lt;br&gt;Firmware sends readings by USB serial or optional Wi-Fi HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#629C56;fontColor=#234A2B;fontSize=14;align=left;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="800" width="225" height="150" as="geometry" />
        </mxCell>
        <mxCell id="iot-gateway" value="&lt;b&gt;Laptop IoT gateway&lt;/b&gt;&lt;br&gt;Python serial bridge / optional Wi-Fi receiver&lt;br&gt;Private SQLite retry outbox&lt;br&gt;Device-key authenticated upload to Plant API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#629C56;fontColor=#234A2B;fontSize=14;align=left;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="800" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sensor-note" value="&lt;b&gt;Data path&lt;/b&gt;&lt;br&gt;ESP32 → host outbox → Plant API → PostgreSQL → authorized dashboards&lt;br&gt;The sensor outbox is local to the host; the ESP32 does not hold the retry queue." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#31543A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="980" width="730" height="75" as="geometry" />
        </mxCell>
        <mxCell id="camera-models" value="&lt;b&gt;Local camera + AI pipeline&lt;/b&gt;&lt;br&gt;OpenCV frames; YOLO human/animal, plant and wrist detection&lt;br&gt;Operator selects monitored plant region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B78A32;fontColor=#53431D;fontSize=14;align=left;spacing=13;" vertex="1" parent="1">
          <mxGeometry x="870" y="800" width="245" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fusion" value="&lt;b&gt;Contact / movement gate&lt;/b&gt;&lt;br&gt;Possible-handling alert requires wrist proximity + fresh same-plant MPU6050 movement + cooldown&lt;br&gt;Clip publisher sends camera-authenticated event metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B78A32;fontColor=#53431D;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="800" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="camera-local" value="&lt;b&gt;Local camera output and storage&lt;/b&gt;&lt;br&gt;Camera HTTP service :8001 serves annotated live feed directly to local web camera view&lt;br&gt;H.264 MP4 + JSON outbox remain on disk; Plant API reads the shared recording folder for authorized playback&lt;br&gt;PostgreSQL stores event metadata and clip references, not video bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B78A32;fontColor=#53431D;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1445" y="790" width="330" height="175" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Scope notes&lt;/b&gt;   The gateway and camera feed are local/development host components. For clip playback, the camera process and Plant API must share access to the same recording directory. This diagram describes repository workflows; it does not certify that all services or hardware are currently running." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8F6;strokeColor=#D0D8D2;fontColor=#42594D;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="845" y="990" width="965" height="65" as="geometry" />
        </mxCell>
