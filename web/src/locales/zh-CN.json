  "speciesContent": {
    "tropical-pitcher-plant": {
      "overview": "热带猪笼草是婆罗洲最具特色的食虫植物之一。它的叶片形成装有液体的特化捕虫笼，能够吸引并捕捉小型昆虫，帮助植株从贫瘠的土壤中获取养分。",
      "habitat": "它生长在潮湿的低地森林、石南林，以及具有酸性贫瘠土壤的开阔地。在尼亚附近，它可能出现在阳光能够照射到的森林边缘湿润植被中。",
      "distribution": "原产于婆罗洲、马来半岛、新加坡和苏门答腊，生长在适宜的潮湿贫瘠环境中。",
      "ecology": "捕虫笼会捕捉昆虫，并为特化生物形成微型水生栖息地，从而为雨林食物网作出贡献。",
      "culture": "猪笼草在婆罗洲被广泛视为岛上非凡植物多样性的象征。",
      "genus": "猪笼草属",
      "localName": "猴杯",
      "conservationStatus": "无危",
      "sensitivityLevel": "敏感",
      "characteristics": [
        "悬垂的花瓶状捕虫笼",
        "红色、绿色或斑驳色彩",
        "攀援生长习性",
        "能够分泌花蜜的笼口"
      ],
      "gallery": ["成熟捕虫笼", "自然栖息地中的捕虫笼", "攀援生长形态"]
    },
    "wild-ginger": {
      "overview": "野姜为阴暗的雨林地面增添鲜艳色彩。硕大的花序从靠近地面的独立花梗长出，高大的叶状枝条则向上伸展。",
      "habitat": "该物种适合生长在温暖潮湿的林缘、溪岸和受扰动的雨林区域，那里土壤肥沃并保持湿润。",
      "distribution": "广泛分布于热带东南亚的潮湿低地、林缘和溪岸环境。",
      "ecology": "花朵为昆虫提供花蜜和花粉，密集的植株则为潮湿林缘中的生物提供遮蔽。",
      "culture": "芳香的花蕾和嫩芽用于区域料理及传统习俗。",
      "genus": "姜荷花属",
      "localName": "火炬姜",
      "conservationStatus": "数据缺乏",
      "sensitivityLevel": "标准",
      "characteristics": [
        "大型粉红或红色花序",
        "高大的叶状茎",
        "芳香的地下根茎",
        "密集丛生的生长形态"
      ],
      "gallery": ["花序", "花朵细节", "叶片与茎的结构"]
    },
    "tree-fern": {
      "overview": "树蕨为雨林增添古老的景观。它不像开花树木，而是通过孢子繁殖，并在直立树干顶端形成由细分叶片组成的冠层。",
      "habitat": "它偏好持续潮湿且阴凉的环境，包括森林山坡、沟谷和溪流附近。",
      "distribution": "分布于东南亚部分地区的潮湿森林，尤其常见于湿润山坡、沟谷和林缘。",
      "ecology": "树蕨有助于维持林下湿度，并为苔藓、附生植物和小型森林生物提供生长表面。",
      "culture": "树蕨是东南亚森林景观中常见的植物，因其独特的古老形态而备受重视。",
      "genus": "桫椤属",
      "localName": "树蕨",
      "conservationStatus": "无危",
      "sensitivityLevel": "标准",
      "characteristics": [
        "高而具纤维的树干",
        "宽阔弯曲的叶片",
        "卷曲的幼嫩叶芽",
        "叶片背面产生孢子"
      ],
      "gallery": ["树蕨标本", "树蕨植物形态", "叶片细节"]
    },
    "borneo-orchid": {
      "overview": "这种优雅的兰花原产于婆罗洲，以星形芳香花朵而备受喜爱。它作为附生植物依附在树上生长，但不会直接从宿主吸收养分。",
      "habitat": "它偏好温暖潮湿、光线柔和且空气流通良好的低地雨林，常生长在高于林地表面的覆苔树枝上。",
      "distribution": "原产于婆罗洲，在温暖潮湿的低地森林中作为附生植物生长。",
      "ecology": "作为附生植物，这种兰花增加了森林冠层的多样性，并依赖特定传粉者和健康的宿主树木。",
      "culture": "本地兰花因其美丽而受到珍视，也是倡导负责任植物保护的重要代表。",
      "genus": "蝴蝶兰属",
      "localName": "婆罗洲兰花",
      "conservationStatus": "未予评估",
      "sensitivityLevel": "敏感",
      "characteristics": ["乳绿色花瓣", "洋红色花心", "宽阔光亮的叶片", "甜美花香"],
      "gallery": ["花朵细节", "花朵与叶片", "成熟开花植株"]
    },
    "rattan-palm": {
      "overview": "藤棕利用钩状结构攀附周围植被向上生长。它细长而柔韧的茎可在林冠下延伸很远。",
      "habitat": "它生长在热带低地及山地雨林中，尤其需要成熟树木为攀援茎提供支撑。",
      "distribution": "分布于东南亚部分地区的热带森林，在低地和山地森林中攀附周围植被生长。",
      "ecology": "攀援藤棕丰富了森林下层结构，其果实也可为野生动物提供食物。",
      "culture": "其坚韧而柔软的藤条长期用于制作家具、篮具、绑扎用品和传统手工艺品。",
      "genus": "省藤属",
      "localName": "玛瑙藤",
      "conservationStatus": "未予评估",
      "sensitivityLevel": "标准",
      "characteristics": ["细长柔韧的藤条", "带钩的攀援结构", "羽状棕榈叶", "成簇果实"],
      "gallery": ["藤棕果实与叶片", "攀援棕榈形态", "藤棕识别细节"]
    },
    "forest-shrub": {
      "overview": "这种桃金娘科常绿植物长出铜红色嫩叶，随后逐渐转为深绿色。淡色小花成簇开放，并含有丰富花粉。",
      "habitat": "它生长在热带森林和沿海环境中，能够适应温暖气候、充沛降雨和明亮的林间空地。",
      "distribution": "分布于包括婆罗洲在内的东南亚部分热带森林和沿海环境。",
